<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <com.github.sshadkany.shapes.CircleView
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_margin="16dp"
            android:gravity="center"
            app:shape_circle_backgroundColor="@color/neomorph_background"
            app:shape_circle_dark_color="@color/dark_shadow"
            app:shape_circle_light_color="@color/light_shadow"
            app:shape_circle_shadow_type="drop_shadow">

            <ImageView
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:radius="100dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nano"/>

        </com.github.sshadkany.shapes.CircleView>

        <com.github.sshadkany.shapes.RoundRectView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            app:shape_roundRect_backgroundColor="@color/neomorph_background"
            app:shape_roundRect_light_color="@color/light_shadow"
            app:shape_roundRect_dark_color="@color/dark_shadow"
            app:shape_roundRect_topLeftRadius="20dp"
            app:shape_roundRect_topRightRadius="20dp"
            app:shape_roundRect_bottomLeftRadius="20dp"
            app:shape_roundRect_bottomRightRadius="20dp"
            app:shape_roundRect_shadow_type="drop_shadow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="25dp"
                android:layout_margin="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Всеволод Лазебный"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="vllazebnyi@example.com"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorSecondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/accent_color"
                    android:alpha="0.3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🟢 Онлайн"
                    android:textColor="@color/accent_color"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.github.sshadkany.shapes.RoundRectView>

    </LinearLayout>

</ScrollView>